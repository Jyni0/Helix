{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix",
  "version": "4.3.0",
  "identifier": "dev.helix.db",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helix",
        "width": 1440,
        "height": 860,
        "minWidth": 980,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#101010",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Universal database client",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
